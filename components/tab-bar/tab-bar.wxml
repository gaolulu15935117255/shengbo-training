<view class="tab-bar">
  <view class="tab-item {{active === 'index' ? 'active' : ''}}" bindtap="goIndex">
    <text class="tab-icon">⌂</text>
    <text>首页</text>
  </view>
  <view class="tab-item {{active === 'quiz' ? 'active' : ''}}" bindtap="goQuiz">
    <text class="tab-icon">✎</text>
    <text>题库</text>
  </view>
  <view class="tab-item {{active === 'shop' ? 'active' : ''}}" bindtap="goShop">
    <text class="tab-icon">🛒</text>
    <text>商城</text>
  </view>
  <view class="tab-item {{active === 'mine' ? 'active' : ''}}" bindtap="goMine">
    <text class="tab-icon">◉</text>
    <text>我的</text>
  </view>
</view>

.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20px);
  display: flex;
  border-top: 1rpx solid #e5e5ea;
  z-index: 100;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #86868b;
}

.tab-item.active {
  color: #007aff;
}

.tab-item.active .tab-icon {
  font-weight: 600;
}

.tab-icon {
  font-size: 36rpx;
  line-height: 1;
  margin-bottom: 6rpx;
  color: inherit;
}

.tab-label {
  font-size: 20rpx;
  font-weight: 500;
  color: inherit;
}

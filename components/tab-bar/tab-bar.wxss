.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  height: 120rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  display: flex;
  border-top: 1rpx solid #efe8e0;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8c8176;
  font-size: 22rpx;
}

.tab-item.active {
  color: #b85c38;
  font-weight: 600;
}

.tab-icon {
  font-size: 34rpx;
  margin-bottom: 4rpx;
}

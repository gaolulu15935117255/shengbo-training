page {
  background: #f8f4ef;
  color: #3d2b1f;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB",
    "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  padding: 24rpx 32rpx 160rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(61, 43, 31, 0.06);
}

.btn-primary {
  background: #b85c38;
  color: #ffffff;
  border-radius: 999rpx;
  text-align: center;
  padding: 22rpx 0;
  font-size: 30rpx;
}

.btn-outline {
  background: #ffffff;
  color: #b85c38;
  border: 2rpx solid #b85c38;
  border-radius: 999rpx;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 8rpx 0 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 0 20rpx;
}

.section-more {
  color: #b85c38;
  font-size: 26rpx;
}

.empty {
  text-align: center;
  color: #8c8176;
  padding: 60rpx 0;
  font-size: 28rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: #f0e8e0;
  color: #b85c38;
}

.tag-free {
  background: #e8f5e9;
  color: #4caf50;
}

.tag-lock {
  background: #fff3e0;
  color: #ff9800;
}

.lock-mask {
  position: relative;
}

.lock-mask::after {
  content: "🔒";
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
}

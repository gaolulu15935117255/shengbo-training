.cover-banner {
  height: 280rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.cover-course,
.cover-exam {
  background: linear-gradient(160deg, #f0f4fa 0%, #e8eef6 100%);
}

.cover-package {
  background: linear-gradient(160deg, #f2f3f8 0%, #eaeaf4 100%);
}

.cover-membership {
  background: linear-gradient(160deg, #f5f7fa 0%, #eef2f8 100%);
}

.cover-label {
  color: #5b8def;
  font-size: 40rpx;
  font-weight: 600;
}

.cover-package .cover-label {
  color: #6e6acd;
}

.cover-membership .cover-label {
  color: #007aff;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
}

.price-row {
  margin: 16rpx 0;
}

.price {
  color: #1d1d1f;
  font-size: 44rpx;
  font-weight: 600;
}

.original {
  color: #c7c7cc;
  font-size: 26rpx;
  text-decoration: line-through;
  margin-left: 12rpx;
}

.rating {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #ff9500;
}

.target {
  font-size: 26rpx;
  color: #86868b;
  margin-bottom: 12rpx;
}

.desc {
  font-size: 28rpx;
  color: #86868b;
  line-height: 1.7;
}

.benefit-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.benefit-icon {
  color: #34c759;
  margin-right: 12rpx;
  font-weight: 600;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid #e5e5ea;
}

.buy-btn {
  margin: 0;
}

.chips {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6d6258;
  font-size: 26rpx;
}

.chip-active {
  background: #b85c38;
  color: #ffffff;
}

.course-card {
  margin-bottom: 16rpx;
}

.course-title {
  font-size: 32rpx;
  font-weight: 600;
}

.course-desc {
  color: #6d6258;
  font-size: 26rpx;
  margin: 12rpx 0;
}

.course-meta {
  color: #8c8176;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  color: #8c8176;
  padding: 80rpx 0;
}

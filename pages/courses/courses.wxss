.chips {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #86868b;
  font-size: 26rpx;
  border: 1rpx solid #e5e5ea;
}

.chip-active {
  background: #e8f2ff;
  color: #007aff;
  border-color: #c7ddf5;
  font-weight: 600;
}

.course-card {
  margin-bottom: 16rpx;
}

.course-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.locked-card {
  opacity: 0.85;
}

.course-title {
  font-size: 32rpx;
  font-weight: 600;
}

.course-desc {
  color: #86868b;
  font-size: 26rpx;
  margin: 12rpx 0;
}

.course-meta {
  color: #86868b;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  color: #86868b;
  padding: 80rpx 0;
}

<view class="container">
  <scroll-view class="chips" scroll-x>
    <view
      class="chip {{activeCategory === item.id ? 'chip-active' : ''}}"
      wx:for="{{categories}}"
      wx:key="id"
      bindtap="switchCategory"
      data-id="{{item.id}}"
    >
      {{item.name}}
    </view>
  </scroll-view>

  <view
    class="card course-card {{item.locked ? 'locked-card' : ''}}"
    wx:for="{{list}}"
    wx:key="id"
    bindtap="goDetail"
    data-id="{{item.id}}"
  >
    <view class="course-header">
      <view class="course-title">{{item.title}}</view>
      <text class="tag tag-free" wx:if="{{item.free}}">免费</text>
      <text class="tag tag-lock" wx:elif="{{item.locked}}">付费</text>
    </view>
    <view class="course-desc">{{item.desc}}</view>
    <view class="course-meta">{{item.level}} · {{item.duration}} · {{item.priceText}}</view>
  </view>

  <view wx:if="{{list.length === 0}}" class="empty">该分类暂无课程</view>
</view>

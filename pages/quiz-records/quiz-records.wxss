.record-item {
  margin-bottom: 16rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-mode {
  font-size: 30rpx;
  font-weight: 600;
}

.record-score {
  font-size: 32rpx;
  font-weight: 600;
  color: #007aff;
}

.record-detail {
  font-size: 26rpx;
  color: #86868b;
  margin-top: 8rpx;
}

.record-time {
  font-size: 24rpx;
  color: #86868b;
  margin-top: 4rpx;
}

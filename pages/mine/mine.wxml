<view class="container">
  <!-- 用户信息 -->
  <view class="card profile">
    <view wx:if="{{isLoggedIn}}" class="profile-row" bindtap="openProfileEditor">
      <image wx:if="{{userInfo.avatarUrl}}" class="avatar-img" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar">{{avatarLetter}}</view>
      <view class="profile-info">
        <view class="name">{{userInfo.nickName}}</view>
        <view class="member-tag">{{membershipLabel}}</view>
        <view class="expire" wx:if="{{membershipExpire}}">{{membershipExpire}}</view>
        <view class="edit-hint">{{needsProfile ? "点击完善微信头像和昵称" : "点击修改头像和昵称"}}</view>
      </view>
    </view>
    <button
      wx:else
      class="login-btn"
      bindtap="onLogin"
      loading="{{loggingIn}}"
      disabled="{{loggingIn}}"
    >
      <view class="login-inner">
        <view class="wechat-icon">微</view>
        <view>
          <view class="name">微信授权登录</view>
          <view class="summary">点授权即可同步头像、昵称和学习数据</view>
        </view>
      </view>
    </button>
    <view class="upgrade-btn" catchtap="goShop" wx:if="{{membershipLabel === '普通用户'}}">开通会员 ›</view>
  </view>

  <!-- 学习数据 -->
  <view class="card stats-card">
    <view class="stats-row">
      <view class="stat-item">
        <view class="stat-num">{{stats.totalAnswered || 0}}</view>
        <view class="stat-label">刷题量</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{accuracy}}%</view>
        <view class="stat-label">正确率</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{stats.studyDays || 1}}</view>
        <view class="stat-label">学习天</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{wrongCount}}</view>
        <view class="stat-label">错题</view>
      </view>
    </view>
  </view>

  <!-- 我的课程 -->
  <view class="section-header">
    <view class="section-title" style="margin:0">我的课程</view>
    <view class="section-more">{{summary}}</view>
  </view>
  <view wx:if="{{learnedCourses.length === 0}}" class="empty card">还没有开始学习，去首页看看课程吧</view>
  <view class="card course-row" wx:for="{{learnedCourses}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
    <view>
      <view class="course-title">{{item.title}}</view>
      <view class="course-meta">{{item.level}} · {{item.duration}}</view>
    </view>
    <text class="arrow">›</text>
  </view>

  <!-- 功能菜单 -->
  <view class="section-title">更多功能</view>
  <view class="card menu-card">
    <view class="menu-item" wx:for="{{menuItems}}" wx:key="title" bindtap="goMenu" data-url="{{item.url}}">
      <text class="menu-icon">{{item.icon}}</text>
      <text class="menu-title">{{item.title}}</text>
      <view class="menu-badge" wx:if="{{item.title === '消息通知' && unreadCount > 0}}">{{unreadCount}}</view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view wx:if="{{isLoggedIn}}" class="logout-btn" bindtap="onLogout">退出登录</view>
</view>

<view wx:if="{{showProfileEditor}}" class="profile-mask" catchtouchmove="preventMove" bindtap="closeProfileEditor">
  <view class="profile-editor" catchtap="preventMove">
    <view class="editor-title">授权微信头像和昵称</view>
    <view class="editor-desc">请点击头像选择「微信头像」，再点击输入框使用微信昵称</view>
    <form bindsubmit="saveProfile">
      <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{editAvatarUrl}}" class="avatar-preview" src="{{editAvatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar-placeholder">选头像</view>
      </button>
      <input
        class="nickname-input"
        type="nickname"
        name="nickName"
        maxlength="32"
        value="{{editNickName}}"
        placeholder="点击填写微信昵称"
        bindblur="onNickNameBlur"
      />
      <button class="btn-primary editor-save" form-type="submit" loading="{{savingProfile}}" disabled="{{savingProfile}}">保存资料</button>
    </form>
    <view class="editor-cancel" bindtap="closeProfileEditor">稍后再说</view>
  </view>
</view>

<tab-bar active="mine" />

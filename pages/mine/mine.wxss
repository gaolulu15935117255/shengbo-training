.profile {
  background: #ffffff;
  color: #1d1d1f;
  margin-bottom: 24rpx;
  position: relative;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.profile-row {
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f5f5f7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
  color: #007aff;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
  border: 2rpx solid #e5e5ea;
}

.profile-info {
  flex: 1;
}

.logout-btn {
  margin: 48rpx 32rpx 0;
  text-align: center;
  color: #86868b;
  font-size: 26rpx;
  padding: 24rpx 0;
}

.login-btn {
  background: transparent;
  border: none;
  padding: 12rpx 0;
  margin: 0;
  text-align: left;
  line-height: 1.5;
  color: #1d1d1f;
  width: 100%;
}

.login-btn::after {
  border: none;
}

.login-inner {
  display: flex;
  align-items: center;
}

.wechat-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #07c160;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.name {
  font-size: 36rpx;
  font-weight: 600;
}

.member-tag {
  display: inline-block;
  background: #e8f2ff;
  color: #007aff;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.expire {
  font-size: 22rpx;
  color: #86868b;
  margin-top: 4rpx;
}

.summary {
  margin-top: 8rpx;
  color: #86868b;
  font-size: 26rpx;
}

.upgrade-btn {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #007aff;
  color: #ffffff;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.stats-card {
  margin-bottom: 32rpx;
}

.stats-row {
  display: flex;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 600;
  color: #007aff;
}

.stat-label {
  font-size: 22rpx;
  color: #86868b;
  margin-top: 4rpx;
}

.course-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.course-title {
  font-size: 30rpx;
  font-weight: 600;
}

.course-meta {
  color: #86868b;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.arrow {
  color: #c7c7cc;
  font-size: 44rpx;
  font-weight: 300;
}

.menu-card {
  padding: 0 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #e5e5ea;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.menu-title {
  flex: 1;
  font-size: 30rpx;
}

.menu-badge {
  background: #ff3b30;
  color: #ffffff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 16rpx;
  text-align: center;
  padding: 0 8rpx;
  margin-right: 12rpx;
}

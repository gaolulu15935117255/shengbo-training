.profile {
  background: #ffffff;
  color: #1d1d1f;
  margin-bottom: 24rpx;
  position: relative;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.profile-row {
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f5f5f7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
  color: #007aff;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
  border: 2rpx solid #e5e5ea;
}

.profile-info {
  flex: 1;
  padding-right: 140rpx;
}

.logout-btn {
  margin: 48rpx 32rpx 0;
  text-align: center;
  color: #86868b;
  font-size: 26rpx;
  padding: 24rpx 0;
}

.login-btn {
  background: transparent;
  border: none;
  padding: 12rpx 0;
  margin: 0;
  text-align: left;
  line-height: 1.5;
  color: #1d1d1f;
  width: 100%;
}

.login-btn::after {
  border: none;
}

.login-inner {
  display: flex;
  align-items: center;
}

.wechat-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #07c160;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.name {
  font-size: 36rpx;
  font-weight: 600;
}

.member-tag {
  display: inline-block;
  background: #e8f2ff;
  color: #007aff;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.expire {
  font-size: 22rpx;
  color: #86868b;
  margin-top: 4rpx;
}

.upgrade-btn {
  position: absolute;
  right: 28rpx;
  top: 36rpx;
  transform: none;
  background: #007aff;
  color: #ffffff;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  z-index: 2;
}

.phone-row {
  margin-top: 20rpx;
  padding-right: 140rpx;
}

.phone-text {
  font-size: 24rpx;
  color: #86868b;
}

.phone-bind-btn {
  display: inline-block;
  margin: 0;
  padding: 0 20rpx;
  height: 52rpx;
  line-height: 52rpx;
  font-size: 22rpx;
  color: #007aff;
  background: #e8f2ff;
  border-radius: 26rpx;
  border: none;
}

.phone-bind-btn::after {
  border: none;
}

.summary {
  margin-top: 8rpx;
  color: #86868b;
  font-size: 26rpx;
}

.edit-hint {
  font-size: 22rpx;
  color: #007aff;
  margin-top: 8rpx;
}

.profile-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.profile-editor {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.editor-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
}

.editor-desc {
  text-align: center;
  color: #86868b;
  font-size: 24rpx;
  margin-top: 12rpx;
  margin-bottom: 36rpx;
}

.avatar-picker {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  margin: 0 auto 32rpx;
  background: #f5f5f7;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-picker::after {
  border: none;
}

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
}

.avatar-placeholder {
  font-size: 26rpx;
  color: #007aff;
}

.nickname-input {
  height: 88rpx;
  line-height: 88rpx;
  background: #f5f5f7;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  margin-bottom: 32rpx;
}

.editor-save {
  width: 100%;
}

.editor-cancel {
  text-align: center;
  color: #86868b;
  font-size: 26rpx;
  padding: 28rpx 0 8rpx;
}

.stats-card {
  margin-bottom: 32rpx;
}

.stats-row {
  display: flex;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 600;
  color: #007aff;
}

.stat-label {
  font-size: 22rpx;
  color: #86868b;
  margin-top: 4rpx;
}

.course-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.course-title {
  font-size: 30rpx;
  font-weight: 600;
}

.course-meta {
  color: #86868b;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.arrow {
  color: #c7c7cc;
  font-size: 44rpx;
  font-weight: 300;
}

.menu-card {
  padding: 0 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #e5e5ea;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.menu-title {
  flex: 1;
  font-size: 30rpx;
}

.menu-badge {
  background: #ff3b30;
  color: #ffffff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 16rpx;
  text-align: center;
  padding: 0 8rpx;
  margin-right: 12rpx;
}

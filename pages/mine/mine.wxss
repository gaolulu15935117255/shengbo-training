.profile {
  background: linear-gradient(135deg, #b85c38, #d4895a);
  color: #ffffff;
  margin-bottom: 24rpx;
  position: relative;
}

.profile-row {
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  margin-right: 24rpx;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
}

.member-tag {
  display: inline-block;
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.expire {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

.login-area {
  padding: 12rpx 0;
}

.summary {
  margin-top: 8rpx;
  opacity: 0.92;
  font-size: 26rpx;
}

.upgrade-btn {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #ffffff;
  color: #b85c38;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.stats-card {
  margin-bottom: 32rpx;
}

.stats-row {
  display: flex;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #b85c38;
}

.stat-label {
  font-size: 22rpx;
  color: #8c8176;
  margin-top: 4rpx;
}

.course-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.course-title {
  font-size: 30rpx;
  font-weight: 600;
}

.course-meta {
  color: #8c8176;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.arrow {
  color: #cbbfb4;
  font-size: 44rpx;
}

.menu-card {
  padding: 0 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0ebe4;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.menu-title {
  flex: 1;
  font-size: 30rpx;
}

.menu-badge {
  background: #e53935;
  color: #ffffff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 16rpx;
  text-align: center;
  padding: 0 8rpx;
  margin-right: 12rpx;
}

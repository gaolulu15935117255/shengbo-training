.chips {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #86868b;
  font-size: 26rpx;
  border: 1rpx solid #e5e5ea;
}

.chip-active {
  background: #e8f2ff;
  color: #007aff;
  border-color: #c7ddf5;
  font-weight: 600;
}

.product-card {
  margin-bottom: 16rpx;
}

.product-row {
  display: flex;
}

.product-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  flex-shrink: 0;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.cover-course {
  background: #f0f4fa;
  color: #5b8def;
}

.cover-package {
  background: #f2f3f8;
  color: #6e6acd;
}

.cover-membership {
  background: #f5f6f8;
  color: #007aff;
}

.cover-exam {
  background: #f0f4fa;
  color: #5b8def;
}

.product-info {
  flex: 1;
  margin-left: 20rpx;
}

.product-title {
  font-size: 30rpx;
  font-weight: 600;
}

.product-desc {
  font-size: 24rpx;
  color: #86868b;
  margin: 8rpx 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-bottom {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.price-row {
  flex: 1;
}

.price {
  color: #1d1d1f;
  font-size: 32rpx;
  font-weight: 600;
}

.original {
  color: #c7c7cc;
  font-size: 24rpx;
  text-decoration: line-through;
  margin-left: 8rpx;
}

.sales {
  font-size: 22rpx;
  color: #86868b;
}

page {
  height: 100%;
  background: #f2f2f7;
}

.quiz-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f2f2f7;
}

/* ===== 顶栏 ===== */
.quiz-header {
  flex-shrink: 0;
  padding: 12rpx 32rpx 16rpx;
  background: #ffffff;
}

.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.progress-num {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.type-tag {
  flex: 1;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #86868b;
}

.timer {
  color: #ff3b30;
  font-weight: 600;
  font-size: 28rpx;
}

.progress-track {
  height: 4rpx;
  background: #e5e5ea;
  border-radius: 2rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #007aff;
  border-radius: 2rpx;
}

/* ===== 滚动区 ===== */
.quiz-scroll {
  flex: 1;
  height: 0;
}

.scroll-bottom {
  height: 24rpx;
}

/* 题目卡片 */
.question-card {
  margin: 20rpx 24rpx 0;
  padding: 28rpx 28rpx 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.stem {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.6;
  color: #1d1d1f;
}

/* iOS 分组选项列表 */
.option-group {
  margin: 16rpx 24rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
}

.option {
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f5;
  box-sizing: border-box;
}

.option:last-child {
  border-bottom: none;
}

.option-selected {
  background: #f0f7ff;
}

.option-correct {
  background: #f0faf4;
}

.option-wrong {
  background: #fff5f5;
}

.opt-label-wrap {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f2f2f7;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.opt-label-selected {
  background: #007aff;
}

.opt-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #86868b;
}

.opt-label-selected .opt-label {
  color: #ffffff;
}

.option-correct .opt-label-wrap {
  background: #34c759;
}

.option-correct .opt-label {
  color: #ffffff;
}

.option-wrong .opt-label-wrap {
  background: #ff3b30;
}

.option-wrong .opt-label {
  color: #ffffff;
}

.opt-text {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.45;
  color: #1d1d1f;
}

.option-selected .opt-text {
  color: #007aff;
  font-weight: 500;
}

.opt-check {
  font-size: 32rpx;
  color: #007aff;
  font-weight: 600;
  margin-left: 12rpx;
}

/* 答题提示 */
.hint-card {
  margin: 16rpx 24rpx 0;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  text-align: center;
}

.hint-text {
  font-size: 26rpx;
  color: #aeaeb2;
}

/* 解析卡片 */
.result-card {
  margin: 16rpx 24rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
}

.result-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 22rpx 28rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.head-correct {
  background: #e8faf0;
  color: #248a3d;
}

.head-wrong {
  background: #fff0f0;
  color: #ff3b30;
}

.result-icon {
  font-size: 32rpx;
}

.result-body {
  padding: 24rpx 28rpx 28rpx;
}

.result-line {
  margin-bottom: 20rpx;
}

.result-line:last-of-type {
  margin-bottom: 16rpx;
}

.result-label {
  display: block;
  font-size: 24rpx;
  color: #86868b;
  margin-bottom: 8rpx;
}

.result-answer {
  font-size: 30rpx;
  font-weight: 600;
  color: #007aff;
}

.result-analysis {
  display: block;
  font-size: 28rpx;
  color: #1d1d1f;
  line-height: 1.7;
}

.knowledge-tag {
  display: inline-block;
  font-size: 24rpx;
  color: #007aff;
  background: #e8f2ff;
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
}

/* ===== 底栏 ===== */
.quiz-footer {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e5e5ea;
}

.fav-btn {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #f2f2f7;
  border-radius: 16rpx;
  font-size: 36rpx;
  color: #007aff;
  flex-shrink: 0;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-radius: 16rpx;
  font-size: 32rpx;
}

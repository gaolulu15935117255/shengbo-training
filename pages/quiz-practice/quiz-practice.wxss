.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.progress {
  font-size: 28rpx;
  font-weight: 600;
}

.type-tag {
  background: #f0e8e0;
  color: #b85c38;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.timer {
  color: #c0392b;
  font-weight: 600;
  font-size: 28rpx;
}

.question-card {
  margin-bottom: 24rpx;
}

.stem {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.option {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 24rpx;
  border: 2rpx solid #efe8e0;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.option-selected {
  border-color: #b85c38;
  background: #fdf6f2;
}

.option-correct {
  border-color: #4caf50;
  background: #e8f5e9;
}

.option-wrong {
  border-color: #e53935;
  background: #ffebee;
}

.opt-label {
  font-weight: 700;
  margin-right: 12rpx;
  color: #b85c38;
}

.opt-text {
  flex: 1;
  font-size: 28rpx;
}

.analysis-card {
  margin-bottom: 24rpx;
}

.result-tag {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.result-correct {
  color: #4caf50;
}

.result-wrong {
  color: #e53935;
}

.analysis-row {
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.analysis-label {
  color: #8c8176;
}

.analysis-content {
  font-size: 26rpx;
  color: #6d6258;
  line-height: 1.7;
  margin-bottom: 12rpx;
}

.knowledge-tag {
  font-size: 24rpx;
  color: #b85c38;
}

.bottom-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.fav-btn {
  padding: 22rpx 28rpx;
  background: #ffffff;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #b85c38;
  box-shadow: 0 4rpx 16rpx rgba(61, 43, 31, 0.08);
}

.action-btn {
  flex: 1;
}

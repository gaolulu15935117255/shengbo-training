<view class="quiz-page" wx:if="{{current}}">
  <view class="quiz-header">
    <view class="header-row">
      <text class="progress-num">{{progress}}</text>
      <text class="type-tag">{{typeLabel}}</text>
      <text class="timer" wx:if="{{mode === 'mock'}}">{{timerDisplay}}</text>
    </view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{progressPercent}}%;"></view>
    </view>
  </view>

  <scroll-view class="quiz-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="question-card">
      <view class="stem">{{current.stem}}</view>
    </view>

    <view class="option-group">
      <view
        class="{{item.optionClass}}"
        wx:for="{{optionStates}}"
        wx:for-item="item"
        wx:key="index"
        bindtap="selectOption"
        data-index="{{index}}"
      >
        <view class="{{item.labelClass}}">
          <text class="opt-label">{{item.label}}</text>
        </view>
        <text class="opt-text">{{item.text}}</text>
        <text class="opt-check" wx:if="{{item.showCheck}}">✓</text>
      </view>
    </view>

    <view class="hint-card" wx:if="{{!submitted}}">
      <text class="hint-text">请选择答案，然后点击底部「确认答案」</text>
    </view>

    <view class="result-card" wx:if="{{submitted}}">
      <view class="result-head {{isCorrect ? 'head-correct' : 'head-wrong'}}">
        <text class="result-icon">{{isCorrect ? '✓' : '✗'}}</text>
        <text>{{isCorrect ? '回答正确' : '回答错误'}}</text>
      </view>
      <view class="result-body">
        <view class="result-line">
          <text class="result-label">正确答案</text>
          <text class="result-answer">{{answerText}}</text>
        </view>
        <view class="result-line">
          <text class="result-label">详细解析</text>
          <text class="result-analysis">{{current.analysis}}</text>
        </view>
        <view class="knowledge-tag">📌 {{current.knowledge}}</view>
      </view>
    </view>

    <view class="scroll-bottom"></view>
  </scroll-view>

  <view class="quiz-footer">
    <view class="fav-btn" bindtap="toggleFav">{{favorited ? '★' : '☆'}}</view>
    <view class="btn-primary action-btn" wx:if="{{!submitted}}" bindtap="submitAnswer">确认答案</view>
    <view class="btn-primary action-btn" wx:else bindtap="nextQuestion">
      {{currentIndex + 1 >= questions.length ? '查看结果' : '下一题'}}
    </view>
  </view>
</view>

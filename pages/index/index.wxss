.banner-section {
  margin-bottom: 28rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow:
    0 12rpx 40rpx rgba(0, 122, 255, 0.15),
    0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.banner-swiper {
  height: 480rpx;
  border-radius: 32rpx;
  overflow: hidden;
}

.banner-item {
  position: relative;
  height: 100%;
  padding: 56rpx 44rpx 72rpx;
  color: #ffffff;
  box-sizing: border-box;
  overflow: hidden;
}

.banner-blue {
  background: linear-gradient(135deg, #007aff 0%, #5ac8fa 100%);
}

.banner-purple {
  background: linear-gradient(135deg, #5856d6 0%, #af52de 100%);
}

.banner-teal {
  background: linear-gradient(135deg, #34c759 0%, #30b0c7 100%);
}

.banner-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.banner-deco-1 {
  width: 320rpx;
  height: 320rpx;
  right: -80rpx;
  top: -60rpx;
}

.banner-deco-2 {
  width: 200rpx;
  height: 200rpx;
  right: 60rpx;
  bottom: -40rpx;
  background: rgba(255, 255, 255, 0.08);
}

.banner-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.banner-tag {
  display: inline-flex;
  align-self: flex-start;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(8px);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.banner-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  line-height: 1.35;
  margin-top: 28rpx;
  max-width: 520rpx;
}

.banner-sub {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.88);
  margin-top: 16rpx;
  line-height: 1.5;
  max-width: 480rpx;
}

.banner-action {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  margin-top: auto;
  padding: 14rpx 28rpx;
  background: rgba(255, 255, 255, 0.95);
  color: #007aff;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.banner-purple .banner-action {
  color: #5856d6;
}

.banner-teal .banner-action {
  color: #248a3d;
}

.banner-arrow {
  margin-left: 4rpx;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 1;
}

.stats-row {
  display: flex;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 0;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #007aff;
}

.stat-label {
  font-size: 22rpx;
  color: #86868b;
  margin-top: 4rpx;
}

.notice-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
}

.notice-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.notice-swiper {
  flex: 1;
  height: 40rpx;
}

.notice-text {
  font-size: 26rpx;
  color: #86868b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.grid-item {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
}

.category-card {
  text-align: center;
  padding: 32rpx 20rpx;
}

.category-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.grid-name {
  font-size: 30rpx;
  font-weight: 600;
}

.grid-hint {
  color: #86868b;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.brand-card {
  margin-bottom: 36rpx;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.brand-slogan {
  font-size: 26rpx;
  color: #86868b;
  margin: 8rpx 0 16rpx;
}

.brand-intro {
  font-size: 26rpx;
  color: #86868b;
  line-height: 1.7;
}

.highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.highlight-item {
  width: calc(50% - 8rpx);
  text-align: center;
  background: #f5f5f7;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  box-sizing: border-box;
}

.hl-icon {
  font-size: 32rpx;
  color: #007aff;
  font-weight: 600;
}

.hl-label {
  font-size: 26rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

.hl-desc {
  font-size: 22rpx;
  color: #86868b;
}

.hot-scroll {
  white-space: nowrap;
  margin-bottom: 36rpx;
}

.hot-item {
  display: inline-block;
  width: 260rpx;
  margin-right: 16rpx;
  vertical-align: top;
}

.hot-cover {
  height: 120rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.hot-cover.cover-course,
.hot-cover.cover-exam {
  background: #f0f4fa;
  color: #5b8def;
}

.hot-cover.cover-package {
  background: #f2f3f8;
  color: #6e6acd;
}

.hot-cover.cover-membership {
  background: #f5f6f8;
  color: #007aff;
}

.hot-title {
  font-size: 26rpx;
  font-weight: 600;
  white-space: normal;
}

.hot-price {
  color: #1d1d1f;
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 8rpx;
}

.course-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.course-title {
  font-size: 30rpx;
  font-weight: 600;
}

.course-meta {
  color: #86868b;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.arrow {
  color: #c7c7cc;
  font-size: 44rpx;
  font-weight: 300;
}

.contact-card {
  margin-bottom: 24rpx;
}

.contact-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e5e5ea;
  font-size: 26rpx;
  color: #86868b;
}

.contact-row:last-child {
  border-bottom: none;
}

.contact-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

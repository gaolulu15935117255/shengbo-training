.result-card {
  text-align: center;
  padding: 60rpx 28rpx;
  margin-bottom: 40rpx;
}

.score-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #e8f2ff;
  color: #007aff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.score-num {
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1;
}

.score-unit {
  font-size: 24rpx;
  color: #86868b;
}

.result-desc {
  font-size: 28rpx;
  color: #86868b;
}

.result-level {
  font-size: 32rpx;
  font-weight: 600;
  color: #007aff;
  margin-top: 16rpx;
}

.retry-btn {
  margin-top: 20rpx;
}

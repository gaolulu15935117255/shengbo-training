.brand-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.brand-slogan {
  font-size: 26rpx;
  color: #86868b;
  margin: 8rpx 0 16rpx;
}

.intro {
  font-size: 28rpx;
  color: #86868b;
  line-height: 1.7;
}

.honor-item {
  padding: 12rpx 0;
  font-size: 28rpx;
}

.contact-row {
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #86868b;
  border-bottom: 1rpx solid #e5e5ea;
}

.contact-row:last-child {
  border-bottom: none;
}

.legal {
  font-size: 28rpx;
}

.legal-desc {
  font-size: 24rpx;
  color: #86868b;
  margin-top: 12rpx;
  line-height: 1.6;
}

.header-card {
  text-align: center;
  margin-bottom: 32rpx;
}

.header-icon {
  font-size: 64rpx;
}

.header-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.header-desc {
  color: #86868b;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.section-tip {
  font-size: 24rpx;
  color: #86868b;
  margin: -12rpx 0 20rpx;
}

.sub-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.sub-item.locked {
  opacity: 0.7;
}

.sub-name {
  font-size: 30rpx;
  font-weight: 600;
}

.sub-meta {
  font-size: 24rpx;
  color: #86868b;
  margin-top: 4rpx;
}

.sub-action {
  color: #007aff;
  font-size: 28rpx;
}

.mode-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.mode-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.mode-info {
  flex: 1;
}

.mode-name {
  font-size: 30rpx;
  font-weight: 600;
}

.mode-desc {
  font-size: 24rpx;
  color: #86868b;
}

.arrow {
  color: #c7c7cc;
  font-size: 40rpx;
}

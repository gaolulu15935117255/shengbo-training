<view class="container" wx:if="{{category}}">
  <view class="card header-card">
    <view class="header-icon">{{category.icon}}</view>
    <view class="header-name">{{category.name}}</view>
    <view class="header-desc">{{category.desc}}</view>
  </view>

  <view class="section-title">章节练习</view>
  <view
    class="card sub-item {{item.locked ? 'locked' : ''}}"
    wx:for="{{subcategories}}"
    wx:key="id"
    bindtap="startChapter"
    data-sub="{{item}}"
  >
    <view>
      <view class="sub-name">{{item.name}}</view>
      <view class="sub-meta">{{item.questionCount}} 道题 · {{item.free ? '免费' : '付费'}}</view>
    </view>
    <text class="sub-action">{{item.locked ? '🔒' : '开始 ›'}}</text>
  </view>

  <view class="section-title">其他模式</view>
  <view class="mode-list">
    <view class="card mode-row" wx:for="{{modes}}" wx:key="id" bindtap="startMode" data-mode="{{item.id}}">
      <text class="mode-icon">{{item.icon}}</text>
      <view class="mode-info">
        <view class="mode-name">{{item.name}}</view>
        <view class="mode-desc">{{item.desc}}</view>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
</view>

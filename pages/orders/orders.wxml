<view class="container">
  <view wx:if="{{orders.length === 0}}" class="empty">暂无订单记录</view>
  <view class="card order-item" wx:for="{{orders}}" wx:key="orderNo">
    <view class="order-header">
      <text class="order-no">{{item.orderNo}}</text>
      <text class="order-status status-{{item.status}}">{{item.statusLabel}}</text>
    </view>
    <view class="order-title">{{item.productTitle}}</view>
    <view class="order-bottom">
      <text class="order-price">¥{{item.amountYuan || item.price}}</text>
      <text class="order-time">{{item.timeText}}</text>
    </view>
    <view wx:if="{{item.canPay}}" class="order-actions">
      <view class="btn-primary repay-btn" catchtap="onRepay" data-orderno="{{item.orderNo}}">继续支付</view>
    </view>
  </view>
</view>

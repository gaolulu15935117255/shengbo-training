.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
}

.meta {
  color: #86868b;
  font-size: 26rpx;
  margin: 12rpx 0;
}

.desc {
  font-size: 28rpx;
  color: #86868b;
  line-height: 1.7;
}

.progress-wrap {
  margin-top: 20rpx;
}

.progress-label {
  font-size: 24rpx;
  color: #007aff;
  margin-bottom: 10rpx;
}

.progress-bar {
  height: 12rpx;
  background: #e8f2ff;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: #007aff;
  border-radius: 8rpx;
}

.outline-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.index {
  width: 40rpx;
  height: 40rpx;
  background: #e8f2ff;
  color: #007aff;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 24rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.lesson-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e5e5ea;
}

.lesson-item:last-child {
  border-bottom: none;
}

.lesson-icon {
  color: #007aff;
  margin-right: 16rpx;
  font-size: 24rpx;
}

.lesson-item.learned .lesson-icon {
  color: #34c759;
}

.lesson-item.learned .lesson-duration {
  color: #34c759;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.half-btn {
  flex: 1;
}

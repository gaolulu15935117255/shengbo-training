<view class="container" wx:if="{{course}}">
  <view class="card header">
    <view class="title-row">
      <view class="title">{{course.title}}</view>
      <text class="tag tag-free" wx:if="{{course.free}}">免费</text>
      <text class="tag tag-lock" wx:elif="{{!hasAccess}}">付费</text>
    </view>
    <view class="meta">{{course.level}} · {{course.duration}} · {{priceText}}</view>
    <view class="desc">{{course.desc}}</view>
  </view>

  <view class="section-title">课程大纲</view>
  <view class="card">
    <view class="outline-item" wx:for="{{course.outline}}" wx:key="*this">
      <text class="index">{{index + 1}}</text>
      <text>{{item}}</text>
    </view>
  </view>

  <view class="section-title">课时列表</view>
  <view class="card">
    <view class="lesson-item" wx:for="{{course.lessons}}" wx:key="title">
      <text class="lesson-icon">▶</text>
      <view class="lesson-info">
        <view>{{item.title}}</view>
        <view class="lesson-duration">{{item.duration}}</view>
      </view>
    </view>
  </view>

  <view class="action-row">
    <view class="btn-outline half-btn" bindtap="goQuiz">配套刷题</view>
    <view class="btn-primary half-btn" bindtap="startLearn">
      {{hasAccess ? (learned ? '继续学习' : '开始学习') : '解锁课程'}}
    </view>
  </view>
</view>

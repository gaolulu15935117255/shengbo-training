page {
  height: 100%;
  background: #f2f2f7;
}

.quiz-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 20rpx 32rpx calc(130rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 统计卡片 ===== */
.stats-card {
  flex-shrink: 0;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 16rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.stats-grid {
  display: flex;
}

.sg-item {
  flex: 1;
  text-align: center;
}

.sg-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #007aff;
  line-height: 1.2;
}

.sg-label {
  font-size: 22rpx;
  color: #86868b;
  margin-top: 8rpx;
}

/* ===== 主体区域撑满 ===== */
.quiz-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  min-height: 0;
}

.section-block {
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.section-block:first-child {
  flex: 1;
}

.tools-block {
  flex-shrink: 0;
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.section-sub {
  font-size: 24rpx;
  color: #86868b;
  margin-top: 4rpx;
}

/* ===== 分类卡片 ===== */
.category-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-height: 0;
}

.category-card {
  flex: 1;
  display: flex;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
  min-height: 200rpx;
}

.cat-accent {
  width: 8rpx;
  flex-shrink: 0;
}

.cat-accent-nanny {
  background: linear-gradient(180deg, #007aff, #5ac8fa);
}

.cat-accent-housekeeper {
  background: linear-gradient(180deg, #5856d6, #af52de);
}

.cat-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 28rpx 28rpx 28rpx 24rpx;
}

.cat-top {
  display: flex;
  align-items: flex-start;
}

.cat-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
  line-height: 1;
}

.cat-info {
  flex: 1;
  min-width: 0;
}

.cat-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.cat-desc {
  font-size: 26rpx;
  color: #86868b;
  margin-top: 8rpx;
  line-height: 1.5;
}

.arrow {
  color: #c7c7cc;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.cat-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.cat-tag {
  font-size: 22rpx;
  color: #007aff;
  background: #e8f2ff;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}

/* ===== 学习工具：三列一行 ===== */
.tools-row {
  display: flex;
  gap: 16rpx;
}

.tool-item {
  flex: 1;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 12rpx 28rpx;
  text-align: center;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
  position: relative;
}

.tool-icon-wrap {
  position: relative;
  display: inline-block;
  margin-bottom: 12rpx;
}

.tool-icon {
  font-size: 48rpx;
  line-height: 1;
}

.tool-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  background: #ff3b30;
  color: #ffffff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 16rpx;
  text-align: center;
  padding: 0 8rpx;
}

.tool-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.tool-desc {
  font-size: 20rpx;
  color: #86868b;
  margin-top: 6rpx;
  line-height: 1.4;
}

# 复制本文件为 .env 并填入真实配置（.env 不要提交到 Git）
# cp .env.example .env

# 服务
PORT=3000
NODE_ENV=development

# MySQL 数据库（请替换为实际连接信息）
DB_HOST=your_mysql_host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=shengbo_training

# JWT 密钥（请使用足够长的随机字符串）
JWT_SECRET=your_user_jwt_secret_change_me
JWT_EXPIRES_IN=30d

# 管理员 JWT（与小程序用户 token 分离）
ADMIN_JWT_SECRET=your_admin_jwt_secret_change_me
ADMIN_JWT_EXPIRES_IN=7d

# 可选：后台管理前端静态资源目录（存在则挂载）
# ADMIN_STATIC_DIR=../admin/dist
